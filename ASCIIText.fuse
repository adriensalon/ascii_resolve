-- Selected 8x8 symbols from the public-domain font8x8 by Daniel Hepper and Marcel Sondaar.
-- https://github.com/dhepper/font8x8/tree/8e279d2d864e79128e96188a6b9526cfa3fbfef9
local symbolRows = {
    { 0x00A0, "0000000000000000" },
    { 0x00B7, "0000001818000000" },
    { 0x2022, "0000001818000000" },
    { 0x2500, "00000000FF000000" },
    { 0x2502, "1010101010101010" },
    { 0x250C, "000000001F101010" },
    { 0x2510, "00000000F0101010" },
    { 0x2514, "101010101F000000" },
    { 0x2518, "10101010F0000000" },
    { 0x251C, "101010101F101010" },
    { 0x2524, "10101010F0101010" },
    { 0x252C, "00000000FF101010" },
    { 0x2534, "10101010FF000000" },
    { 0x253C, "10101010FF101010" },
    { 0x2550, "000000FF00FF0000" },
    { 0x2551, "2828282828282828" },
    { 0x2554, "0000003F202F2828" },
    { 0x2557, "000000F808E82828" },
    { 0x255A, "2828282F203F0000" },
    { 0x255D, "282828E808F80000" },
    { 0x2560, "2828282F202F2828" },
    { 0x2563, "282828E808E82828" },
    { 0x2566, "000000FF00EF2828" },
    { 0x2569, "282828EF00FF0000" },
    { 0x256C, "282828EF00EF2828" },
    { 0x2580, "FFFFFFFF00000000" },
    { 0x2584, "00000000FFFFFFFF" },
    { 0x2588, "FFFFFFFFFFFFFFFF" },
    { 0x258C, "F0F0F0F0F0F0F0F0" },
    { 0x2590, "0F0F0F0F0F0F0F0F" },
    { 0x2591, "AA005500AA005500" },
    { 0x2592, "AA55AA55AA55AA55" },
    { 0x2593, "FF55FFAAFF55FFAA" },
    { 0x25AA, "00003C3C3C3C0000" },
}

local fontNames, symbolTokens = {}, {}
for index, font in ipairs(bannerFonts) do
    fontNames[index] = font[1]
end
for index, symbol in ipairs(symbolRows) do
    symbolTokens[symbol[1]] = string.char(127 + index)
end

local function menu(label, id, default, options)
    local attrs = {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = default,
        INP_Integer = true,
    }
    for _, option in ipairs(options) do
        attrs[#attrs + 1] = { CCS_AddString = option }
    end
    return self:AddInput(label, id, attrs)
end

local function slider(label, id, default, low, high, integer)
    return self:AddInput(label, id, {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = default,
        INP_MinScale = low,
        INP_MaxScale = high,
        INP_MinAllowed = low,
        INP_MaxAllowed = high,
        INP_Integer = integer or false,
    })
end

local function fontInput(label, id, control, default)
    return self:AddInput(label, id, {
        LINKID_DataType = "Text",
        INPID_InputControl = "FontFileControl",
        IC_ControlGroup = 2,
        IC_ControlID = control,
        INPS_DefaultText = default,
        INP_Required = false,
    })
end

local function colorInput(id, control)
    return self:AddInput(id, id, {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        ICS_Name = "Color",
        IC_ControlGroup = 3,
        IC_ControlID = control,
        INP_Default = 1,
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
    })
end

function Create()
    -- Source tools provide the main image output and frame format controls.
    InText = self:AddInput("Styled Text", "StyledText", {
        LINKID_DataType = "Text",
        INPID_InputControl = "TextEditControl",
        INPS_DefaultText = "ASCII Text",
        TEC_Lines = 4,
        TEC_CharLimit = textLimit,
        INP_Required = false,
    })
    InBannerFont = menu("Banner Font", "BannerFont", 0, fontNames)
    InSpacing = menu("Letter Spacing", "Spacing", 0, { "Fitted", "Full" })
    InWrapWidth = slider("Characters Across (0 = No Wrap)", "WrapWidth", 80, 0, 160, true)
    InAlignment = menu("Alignment", "Alignment", 1, { "Left", "Center", "Right" })
    InCenter = self:AddInput("Center", "Center", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.5,
        INP_DefaultY = 0.5,
    })
    InSize = slider("Size", "Size", 0.8, 0, 1)
    InFontSource = menu("Font Source", "FontSource", 0, { "Embedded Bitmap", "Installed Font" })
    InFontFamily = fontInput("Font Family", "FontFamily", 0, "Arial")
    InFontStyle = fontInput("Font Style", "FontStyle", 1, "Regular")
    InRed = colorInput("Red", 0)
    InGreen = colorInput("Green", 1)
    InBlue = colorInput("Blue", 2)
    InAlpha = colorInput("Alpha", 3)
end

local function symbolToken(text)
    local first, second, third = text:byte(1, 3)
    local code
    if #text == 2 then
        code = (first - 192) * 64 + second - 128
    elseif #text == 3 then
        code = (first - 224) * 4096 + (second - 128) * 64 + third - 128
    end
    return symbolTokens[code] or "?"
end

local function parseFont(data)
    local nextLine = data:gmatch("(.-)\n")
    local header = nextLine()
    local hardblank, height, comments, direction = header:match(
        "^[ft]lf2a(%S+)%s+(%d+)%s+%-?%d+%s+%-?%d+%s+%-?%d+%s+(%d+)%s*(%d*)")
    if not hardblank then
        return nil
    end
    height, comments = tonumber(height), tonumber(comments)
    hardblank = hardblank:gsub("(%W)", "%%%1")
    for _ = 1, comments do
        nextLine()
    end

    local font = { glyphs = {}, blankRows = {}, rtl = direction == "1" }
    for y = 1, height do
        font.blankRows[y] = ""
    end
    for code = 32, 126 do
        local glyph = { rows = {}, width = 0 }
        for y = 1, height do
            local row = nextLine()
            if not row then
                return nil
            end
            row = row:gsub("[ \t]+$", "")
            local endmark = row:sub(-1)
            local terminatorWidth = y == height and row:sub(-2, -2) == endmark and 2 or 1
            -- Reserve one byte for hardblanks and one byte per display symbol so layout measures columns.
            row = row:sub(1, -1 - terminatorWidth):gsub(hardblank, "\1")
                :gsub("[\194-\244][\128-\191]+", symbolToken)
            glyph.rows[y] = row
            glyph.width = max(glyph.width, #row)
        end
        for y, row in ipairs(glyph.rows) do
            glyph.rows[y] = row .. string.rep(" ", glyph.width - #row)
        end
        font.glyphs[code] = glyph
    end
    return font
end

local cachedFont, cachedFontIndex
local function bannerFont(index)
    if cachedFontIndex ~= index then
        local entry = bannerFonts[index] or bannerFonts[1]
        cachedFont = entry and parseFont(entry[2])
        cachedFontIndex = index
    end
    return cachedFont
end

local function appendGlyph(line, glyph, fitted, rtl)
    if not line then
        return glyph
    end
    if rtl then
        line, glyph = glyph, line
    end

    local overlap = 0
    if fitted then
        overlap = min(line.width, glyph.width)
        for y, row in ipairs(line.rows) do
            overlap = min(overlap, #row:match(" *$") + #glyph.rows[y]:match("^ *"))
        end
    end
    local result = { rows = {}, width = line.width + glyph.width - overlap }
    for y, row in ipairs(line.rows) do
        local preserved = min(overlap, #glyph.rows[y]:match("^ *"))
        result.rows[y] = row:sub(1, line.width - overlap + preserved)
            .. glyph.rows[y]:sub(preserved + 1)
    end
    return result
end

local function appendWord(line, word, font, fitted, wrapWidth)
    for index = 1, #word do
        line = appendGlyph(line, font.glyphs[word:byte(index)], fitted, font.rtl)
        if wrapWidth > 0 and line.width > wrapWidth then
            return nil
        end
    end
    return line
end

local function trimBanner(rows)
    local result, left, right = {}, math.huge, 0
    for y, row in ipairs(rows) do
        row = row:gsub("\1", " "):gsub(" *$", "")
        result[y] = row
        if #row > 0 then
            left = min(left, row:find("[^ ]"))
            right = max(right, #row)
        end
    end
    if right > 0 then
        for y, row in ipairs(result) do
            result[y] = row:sub(left)
        end
    end
    return { rows = result, width = max(0, right - left + 1) }
end

local function makeBanner(text, font, wrapWidth, fitted)
    text = text:gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\t", "    ")
    text = text:gsub("[\194-\244][\128-\191]*", "?"):gsub("[^ -~\n]", "?"):sub(1, textLimit)
    local lines, width = {}, 0
    local function addLine(line)
        local trimmed = trimBanner(line and line.rows or font.blankRows)
        lines[#lines + 1] = trimmed
        width = max(width, trimmed.width)
    end

    for paragraph in (text .. "\n"):gmatch("(.-)\n") do
        local line
        for gap, word in paragraph:gmatch("( *)([^ ]+)") do
            local candidate = appendWord(line, (line and gap or "") .. word, font, fitted, wrapWidth)
            if not candidate then
                if line then
                    addLine(line)
                    line = nil
                end
                for index = 1, #word do
                    local glyph = font.glyphs[word:byte(index)]
                    candidate = appendGlyph(line, glyph, fitted, font.rtl)
                    if line and candidate.width > wrapWidth then
                        addLine(line)
                        candidate = glyph
                    end
                    line = candidate
                end
            else
                line = candidate
            end
        end
        addLine(line)
    end
    return lines, width
end

local function bitmapShape(encoded, width, height, rowOffset, xStep, yStep)
    local shape = Shape()
    for y = 0, height - 1 do
        local bits = tonumber(encoded:sub(2 * y + 1, 2 * y + 2), 16)
        local top, bottom = (rowOffset - y) * yStep, (rowOffset - y - 1) * yStep
        local first
        for x = 0, width do
            local on = x < width and floor(bits / 2 ^ (width - 1 - x)) % 2 == 1
            if on then
                first = first or x
            elseif first then
                local left, right = first * xStep, x * xStep
                shape:MoveTo(left, bottom)
                shape:LineTo(right, bottom)
                shape:LineTo(right, top)
                shape:LineTo(left, top)
                shape:Close()
                first = nil
            end
        end
    end
    return shape
end

local function installedFace(family, style)
    local families = FontManager:GetFontList() or {}
    if not next(families) then
        FontManager:ScanDir()
        families = FontManager:GetFontList() or {}
    end
    local styles = families[family]
    if not styles then
        return nil
    end
    if not styles[style] then
        style = styles.Regular and "Regular" or next(styles)
    end
    local font = TextStyleFont(family, style)
    local metrics = font and TextStyleFontMetrics(font)
    if not metrics or not metrics.Scale or metrics.Scale <= 0 then
        return nil
    end
    local ascent, descent = math.abs(metrics.TextAscent), math.abs(metrics.TextDescent)
    local widest = 0
    for code = 33, 126 do
        widest = max(widest, metrics:CharacterWidth(code) or 0)
    end
    if widest <= 0 or ascent + descent <= 0 then
        return nil
    end
    local size = min(0.9 / widest, (cellHeight - 0.15) / (ascent + descent)) / 10
    return {
        metrics = metrics,
        scale = size / metrics.Scale,
        baseline = (cellHeight - (ascent + descent) * size * 10) / 2 + descent * size * 10,
    }
end

local function characterShape(token, face)
    local symbol = symbolRows[token - 127]
    local code = symbol and symbol[1] or token
    if code == 160 then
        return nil
    end
    local glyph = face and face.metrics:GetCharacterShape(code, false)
    if glyph then
        local matrix = Matrix4()
        matrix:Scale(face.scale, face.scale, 1)
        matrix:Move(0.5, face.baseline, 0)
        return glyph:TransformOfShape(matrix)
    end
    if symbol then
        return bitmapShape(symbol[2], 8, 8, 8, 1 / 8, cellHeight / 8)
    end
    local encoded = bitmapRows[code - 32]
    return encoded and bitmapShape(encoded, 5, 7, 8, 1 / 6, 1 / 6)
end

local function drawBanner(image, req, lines, width, center, size, alignment, color, face)
    local rows = {}
    for _, line in ipairs(lines) do
        if #rows > 0 then
            rows[#rows + 1] = { text = "", width = 0 }
        end
        for _, row in ipairs(line.rows) do
            rows[#rows + 1] = { text = row, width = line.width }
        end
    end
    local first, last = 1, #rows
    while rows[first].text == "" do
        first = first + 1
    end
    while rows[last].text == "" do
        last = last - 1
    end

    local aspect = image.Height * image.YScale / (image.Width * image.XScale)
    local height = (last - first + 1) * cellHeight
    local scale = size * min(1 / width, aspect / height)
    local left = center.X - width * scale / 2
    local top = center.Y * aspect + height * scale / 2
    local banner, matrix, glyphs = Shape(), Matrix4(), {}
    local hasInk = false
    for y = first, last do
        if self.Status ~= "OK" then
            return false
        end
        local row = rows[y]
        local x = left + (width - row.width) * scale * alignment / 2
        local bottom = top - (y - first + 1) * scale * cellHeight
        if bottom < aspect and bottom + scale * cellHeight > 0 then
            for column, char in row.text:gmatch("()([^ ])") do
                local cellLeft = x + (column - 1) * scale
                if cellLeft < 1 and cellLeft + scale > 0 then
                    local code = char:byte()
                    if glyphs[code] == nil then
                        glyphs[code] = characterShape(code, face) or false
                    end
                    if glyphs[code] then
                        matrix:Identity()
                        matrix:Scale(scale, scale, 1)
                        matrix:Move(cellLeft, bottom, 0)
                        banner:AddShape(glyphs[code]:TransformOfShape(matrix))
                        hasInk = true
                    end
                end
            end
        end
    end

    if hasInk then
        local channel = ImageChannel(image, req:IsQuick() and 1 or 8)
        local paint = ChannelStyle()
        paint.Color = color
        channel:SetStyleFill(FillStyle())
        channel:ShapeFill(banner)
        channel:PutToImage("CM_Merge", paint)
    end
    return true
end

function Process(req)
    local precalc = req:IsPreCalc()
    local attrs = {
        { IMG_Channel = "Red" },
        { IMG_Channel = "Green" },
        { IMG_Channel = "Blue" },
        { IMG_Channel = "Alpha" },
        IMG_Document = self.Comp,
        IMG_Width = max(1, floor(Width / Scale)),
        IMG_Height = max(1, floor(Height / Scale)),
        IMG_XScale = XAspect,
        IMG_YScale = YAspect,
        IMAT_OriginalWidth = Width,
        IMAT_OriginalHeight = Height,
        IMG_Quality = not req:IsQuick(),
        IMG_NoData = precalc,
    }
    if not req:IsStampOnly() then
        attrs.IMG_ProxyScale = 1
    end
    if SourceDepth ~= 0 then
        attrs.IMG_Depth = SourceDepth
    end
    local image = Image(attrs)
    if precalc then
        OutImage:Set(req, image)
        return
    end
    image:Fill(Pixel())

    local function value(input, default)
        local parameter = input:GetValue(req)
        return parameter and parameter.Value or default
    end
    local font = bannerFont(value(InBannerFont) + 1)
    if not font then
        OutImage:Set(req, image)
        return
    end
    local lines, width = makeBanner(value(InText, ""), font, value(InWrapWidth), value(InSpacing) == 0)
    local size, alpha = value(InSize), value(InAlpha)
    if width > 0 and size > 0 and alpha > 0 then
        local face
        if value(InFontSource) == 1 then
            local ok, installed = pcall(installedFace, value(InFontFamily, "Arial"), value(InFontStyle, "Regular"))
            face = ok and installed or nil
        end
        local color = Pixel({ R = value(InRed), G = value(InGreen), B = value(InBlue), A = alpha })
        local center = InCenter:GetValue(req)
        if not drawBanner(image, req, lines, width, center, size, value(InAlignment), color, face) then
            return
        end
    end
    OutImage:Set(req, image)
end
