FuRegisterClass("AsciiTextTitle", CT_SourceTool, {
    REGS_Name = "ASCII Text",
    REGS_Category = "Fuses\\Titles",
    REGS_OpIconString = "ATxt",
    REGS_OpDescription = "Build text banners from ASCII characters",
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
    REG_OpNoMask = true,
    REG_Source_GlobalCtrls = true,
    REG_Source_SizeCtrls = true,
    REG_Source_AspectCtrls = true,
    REG_Source_DepthCtrls = true,
    REG_Version = 1,
})

local floor, min, max = math.floor, math.min, math.max
local textLimit = 512
local cellHeight = 9 / 6

local bannerFonts = { --[[InstallASCII.ps1 inserts the FIGlet assets here]] }

-- Each pair of hex digits is one row of the ASCII Art 5x7 bitmap.
local bitmapRows = {
    "04040404040004", -- !
    "0A0A0A00000000", -- "
    "0A0A1F0A1F0A0A", -- #
    "040F140E051E04", -- $
    "19190204081313", -- %
    "0C12140815120D", -- &
    "04040800000000", -- '
    "02040808080402", -- (
